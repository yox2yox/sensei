      "icon": "🎟️",
      "parentId": "auth-controller",
      "analogy": "カードキー発行機",
      "responsibility": "本人確認済みの利用者に、以後使う認証トークンを渡す",
      "evidence": [
        {
          "path": "src/auth/tokenIssuer.ts",
          "startLine": 12,
          "endLine": 24,
          "label": "JWT 発行のコア",
          "codeSnippets": {
            "language": "ts",
            "code": [
              "export function issueToken(user: User): string {",
              "  const payload = {",
              "    sub: user.id,",
              "    iat: Math.floor(Date.now() / 1000),",
              "    exp: Math.floor(Date.now() / 1000) + 60 * 60,",
              "  }",
              "  return jwt.sign(payload, SECRET, { algorithm: 'HS256' })",
              "}"
            ]
          }
        }
      ]
    },
