    {
      "id": "guest",
      "type": "person",
      "name": "宿泊者",
      "description": "認証システムを利用するエンドユーザー。ホテルにとっての宿泊客にあたる。",
      "icon": "🧑",
      "analogy": "ホテルにチェックインする客"
    },
    {
      "id": "identity-provider",
      "type": "external-system",
      "name": "外部IdP",
      "description": "外部の ID プロバイダ。今回は宿泊者が事前に発行された資格情報を使ってログインする想定。",
      "icon": "🛰️",
      "analogy": "宿泊者が事前に作った会員カード"
    },
    {
      "id": "frontend",
      "type": "client",
      "name": "フロントエンド",
      "description": "ブラウザ上で動作する SPA。資格情報の入力からダッシュボードの表示まで担う。",
      "icon": "💻",
      "analogy": "チェックイン用紙と部屋キーを持ち歩く宿泊客の手帳"
    },
    {
      "id": "api-gateway",
      "type": "server",
      "name": "APIゲートウェイ",
      "description": "外部からのリクエストを受け付け、内部サービスへルーティングする入口。",
      "icon": "🌐",
      "analogy": "ホテル入口のコンシェルジュ"
    },
    {
      "id": "auth-service",
